	partition fct_pipeline_runs = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(WarehouseServer, WarehouseDatabase),
				    Data = Source{[Schema = "marts", Item = "fct_pipeline_runs"]}[Data],
				    Numbers = Table.TransformColumnTypes(Data, {{"duration_seconds", type number}, {"dlq_rate", type number}, {"estimated_cost_usd", type number}}),
				    Utc = Table.TransformColumns(Numbers, {{"started_at", each if _ = null then null else DateTimeZone.RemoveZone(DateTimeZone.ToUtc(_)), type datetime}, {"finished_at", each if _ = null then null else DateTimeZone.RemoveZone(DateTimeZone.ToUtc(_)), type datetime}})
				in
				    Utc

	annotation PBI_ResultType = Table
