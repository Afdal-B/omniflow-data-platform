				    Source = PostgreSQL.Database(WarehouseServer, WarehouseDatabase),
				    Data = Source{[Schema = "marts", Item = "dim_products"]}[Data],
				    Numbers = Table.TransformColumnTypes(Data, {{"current_unit_price", type number}}),
