	partition fct_orders = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(WarehouseServer, WarehouseDatabase),
				    Data = Source{[Schema = "marts", Item = "fct_orders"]}[Data],
				    Numbers = Table.TransformColumnTypes(Data, {{"gross_amount", type number}, {"discount_amount", type number}, {"net_amount", type number}}),
				    Utc = Table.TransformColumns(Numbers, {{"ordered_at", each if _ = null then null else DateTimeZone.RemoveZone(DateTimeZone.ToUtc(_)), type datetime}, {"updated_at", each if _ = null then null else DateTimeZone.RemoveZone(DateTimeZone.ToUtc(_)), type datetime}})
				in
				    Utc

	annotation PBI_ResultType = Table
