{
  "name": "Stratum",
  "dataColors": ["#2563EB", "#14B8A6", "#F59E0B", "#8B5CF6", "#EC4899", "#64748B", "#22C55E", "#EF4444"],
  "foreground": "#111827",
  "foregroundNeutralSecondary": "#6B7280",
  "foregroundNeutralTertiary": "#9CA3AF",
  "background": "#FFFFFF",
  "backgroundLight": "#F4F6FA",
  "backgroundNeutral": "#E5E7EB",
  "tableAccent": "#2563EB",
  "good": "#16A34A",
  "neutral": "#F59E0B",
  "bad": "#DC2626",
  "maximum": "#2563EB",
  "center": "#BFDBFE",
  "minimum": "#EFF6FF",
  "textClasses": {
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#111827" },
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#111827" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#374151" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#6B7280" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F6FA" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F4F6FA" } } }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E5E7EB" } }, "radius": 12 }],
        "dropShadow": [{ "show": false }],
        "padding": [{ "top": 12, "bottom": 12, "left": 16, "right": 16 }],
        "title": [{ "show": true, "fontSize": 12, "bold": true, "fontColor": { "solid": { "color": "#111827" } } }],
        "visualHeader": [{ "show": false }],
        "categoryAxis": [{ "showAxisTitle": false, "fontSize": 9, "labelColor": { "solid": { "color": "#6B7280" } } }],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "fontSize": 9,
            "labelColor": { "solid": { "color": "#9CA3AF" } },
            "gridlineShow": true,
            "gridlineColor": { "solid": { "color": "#EEF0F4" } },
            "gridlineThickness": 1
          }
        ],
        "legend": [{ "show": true, "position": "Top", "fontSize": 9, "labelColor": { "solid": { "color": "#6B7280" } } }]
      }
    },
    "card": {
      "*": {
        "title": [{ "show": false }],
        "labels": [{ "fontSize": 26, "color": { "solid": { "color": "#111827" } } }],
        "categoryLabels": [{ "show": true, "fontSize": 10, "color": { "solid": { "color": "#6B7280" } } }]
      }
    },
    "clusteredBarChart": {
      "*": {
        "labels": [{ "show": true, "fontSize": 9, "color": { "solid": { "color": "#374151" } } }],
        "valueAxis": [{ "show": false }]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "labels": [{ "show": true, "fontSize": 9, "color": { "solid": { "color": "#374151" } } }]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 3 }]
      }
    },
    "donutChart": {
      "*": {
        "legend": [{ "show": true, "position": "Bottom" }],
        "labels": [{ "show": true, "labelStyle": "Percent of total" }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{ "gridVertical": false, "gridHorizontalColor": { "solid": { "color": "#EEF0F4" } }, "rowPadding": 2 }],
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#6B7280" } }, "backColor": { "solid": { "color": "#FFFFFF" } }, "bold": true }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#111827" } }, "backColorPrimary": { "solid": { "color": "#FFFFFF" } }, "backColorSecondary": { "solid": { "color": "#FAFBFD" } } }],
        "total": [{ "bold": true }]
      }
    },
    "slicer": {
      "*": {
        "title": [{ "show": false }],
        "header": [{ "show": false }],
        "border": [{ "show": false }],
        "background": [{ "show": false }]
      }
    },
    "textbox": {
      "*": {
        "title": [{ "show": false }],
        "border": [{ "show": false }],
        "background": [{ "show": false }],
        "padding": [{ "top": 0, "bottom": 0, "left": 0, "right": 0 }]
      }
    }
  }
}
